{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "csv-quiz-studio",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "quiz-studio.takutakus.com", "custom_domain": true }],
  "workers_dev": false,
  // Static SPA: serve dist/, and fall back to index.html for client-side routes like /quiz/:id
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
